FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
VOTELEDGER_DATABASE=voters.db
PORT=5000
# Optional Twilio delivery. Without these, OTPs are returned as demo_otp locally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# SMTP email delivery. Copy this file to .env and fill in your Gmail App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
